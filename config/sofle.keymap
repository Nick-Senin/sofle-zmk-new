#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        Onlytap: Onlytap {
            compatible = "zmk,behavior-hold-tap";
            label = "ONLYTAP";
            bindings = <&none>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "tap-preferred";
        };

        center_win_management: center_win_management {
            compatible = "zmk,behavior-tap-dance";
            label = "CENTER_WIN_MANAGEMENT";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(NUMBER_3)))>, <&kp LA(LC(NUMBER_3))>;
        };

        left_win_management: left_win_management {
            compatible = "zmk,behavior-tap-dance";
            label = "LEFT_WIN_MANAGEMENT";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(LG(NUMBER_2)))>, <&kp LA(LC(NUMBER_2))>;
        };

        right_win_behavoir: right_win_behavoir {
            compatible = "zmk,behavior-tap-dance";
            label = "RIGHT_WIN_BEHAVOIR";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(NUMBER_4)))>, <&kp LA(LC(NUMBER_4))>;
        };

        far_left_win_management: far_left_win_management {
            compatible = "zmk,behavior-tap-dance";
            label = "FAR_LEFT_WIN_MANAGEMENT";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(NUMBER_1)))>, <&kp LA(LC(NUMBER_1))>;
        };

        far_right_win_management: far_right_win_management {
            compatible = "zmk,behavior-tap-dance";
            label = "FAR_RIGHT_WIN_MANAGEMENT";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(NUMBER_5)))>, <&kp LA(LC(NUMBER_5))>;
        };

        HOLD_TAP_BEHAVOIR: HOLD_TAP_BEHAVOIR {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_BEHAVOIR";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <2000>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_main {
            label = "mac_default";
            bindings = <
&kp ESCAPE         &kp N1  &kp N2    &kp N3            &kp N4        &kp N5                                    &kp N6  &kp N7             &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB            &kp Q   &kp W     &kp E             &kp R         &kp T                                     &kp Y   &kp U              &kp I      &kp O     &kp P     &kp LEFT_BRACKET
&kp LA(BACKSPACE)  &kp A   &kp S     &kp D             &kp F         &kp G                                     &kp H   &kp J              &kp K      &kp L     &kp SEMI  &HOLD_TAP_BEHAVOIR 0 APOS
&kp LSHFT          &kp Z   &kp X     &kp C             &kp V         &kp B   &kp LS(LA(LC(F)))    &kp LA(F19)  &kp N   &kp M              &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                           &kp LGUI  &kp LEFT_CONTROL  &kp LEFT_ALT  &mo 1   &kp SPACE            &kp RETURN   &mo 2   &kp LC(LA(SPACE))  &mo 3      &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp (LC(F16)) LC(F17)>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        mac_lower {
            label = "mac_lower";
            bindings = <
&kp LG(Q)      &far_left_win_management  &left_win_management  &center_win_management  &right_win_behavoir  &far_right_win_management                                    &none               &none             &none          &none              &none   &none
&kp LG(TAB)    &kp LG(W)                 &kp LS(LC(TAB))       &kp UP_ARROW            &kp LC(TAB)          &kp LC(LG(CAPSLOCK))                                         &trans              &kp LA(LG(LEFT))  &trans         &kp LA(LG(RIGHT))  &trans  &trans
&kp BACKSPACE  &kp EXCL                  &kp LEFT_ARROW        &kp DOWN                &kp RIGHT            &kp LG(CAPSLOCK)                                             &kp LA(LEFT_ARROW)  &kp LA(UP_ARROW)  &kp LA(DOWN)   &kp LA(RIGHT)      &trans  &kp LS(LG(DELETE))
&trans         &kp LG(A)                 &kp LG(X)             &kp LG(C)               &kp LG(V)            &kp DELETE                 &kp K_MUTE     &trans             &kp LS(LG(H))       &kp LS(LG(M))     &kp LS(LG(F))  &trans             &trans  &trans
                                         &kp LC(F13)           &mo 3                   &lt 3 TAB            &trans                     &key_repeat    &kp LA(LC(ENTER))  &kp LC(O)           &trans            &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_AC_ZOOM_OUT C_AC_ZOOM_IN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            label = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&kp TAB  &kp F1  &kp F2     &kp F3            &kp F4     &kp F5                                  &trans                &trans                 &trans        &trans     &trans           &trans
&trans   &none   &none      &kp LA(UP_ARROW)  &none      &kp KP_MINUS                            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE      &kp ESC    &kp SLCK         &kp CAPS
&trans   &none   &none      &none             &none      &none                                   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp UP_ARROW  &kp RIGHT  &kp INS          &mt RIGHT_CONTROL K_APP
&trans   &none   &kp MINUS  &kp PLUS          &kp EQUAL  &trans        &trans         &trans     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp DOWN      &kp PG_DN  &kp PAUSE_BREAK  &trans
                 &trans     &trans            &trans     &trans        &lt 3 ENTER    &lt 3 ESC  &trans                &trans                 &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            label = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2      &bt BT_SEL 3   &bt BT_SEL 4                             &none  &kp K_PREV     &kp C_PP          &kp K_NEXT     &none  &gresc
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &kp LG(UP_ARROW)  &none          &none                                    &none  &kp LS(LG(U))  &kp LS(LG(I))     &kp LS(LC(O))  &none  &none
&none              &rgb_ug RGB_BRD  &kp LG(LEFT)     &kp LG(DOWN)      &kp LG(RIGHT)  &none                                    &none  &kp LS(LC(J))  &kp LS(LG(K))     &kp RS(RG(L))  &none  &none
&none              &none            &none            &kp LG(D)         &none          &none         &rgb_ug RGB_TOG    &none   &none  &kp C_VOL_DN   &kp C_PLAY_PAUSE  &kp C_VOL_UP   &none  &none
                                    &none            &none             &none          &none         &kp LG(ENTER)      &trans  &none  &none          &trans            &none
            >;
        };
    };
};
